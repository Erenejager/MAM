PORT=3001
STORAGE_ROOT=/mnt/mam
GROQ_API_KEY=your_groq_api_key_here
OPENSEARCH_URL=http://localhost:9200
DATABASE_PATH=~/.mam/mam.db
NODE_ENV=development
AUTH_PASSWORD=$2a$10$examplehashhere
CORS_ORIGIN=
GEMINI_API_KEY=               # Required for OCR vision — frame analysis via Gemini Flash
OPENAI_API_KEY=               # Required for OCR curation — final scoring pass via GPT-4o mini
MAM_SCOREBOARD_DETECTOR_ENABLED=0
MAM_SCOREBOARD_DETECTOR_IMAGE=scoreboard-detector
MAM_SCOREBOARD_DETECTOR_MODEL_DIR=/home/clawdbot/MAM/models/scoreboard-yolo
MAM_SCOREBOARD_DETECTOR_MODEL=best.onnx
MAM_SCOREBOARD_DETECTOR_CONF=0.25
MAM_SCOREBOARD_DETECTOR_LIMIT=40
